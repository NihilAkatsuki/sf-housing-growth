   "source": [
    "### 2c. Recover Missing Coordinates\n",
    "\n",
    "- Keep original Land Use coordinates.\n",
    "- For still-unmatched records, use a DBI **primary-address coordinate** when its `BPA` has exactly **one unique coordinate**.\n",
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "30796b76",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Before DBI - unmatched records: 2027\n",
      "Before DBI - unmatched net units: 39195\n"
     ]
    }
   ],
   "source": [
    "# Use original Land Use matching results before DBI fills missing points.\n",
    "located[\"land_use_match_status\"] = located[\"match_status\"]\n",
    "\n",
    "original_unmatched = located.loc[located[\"match_status\"] == \"unmatched\"].copy()\n",
    "print(\"Before DBI - unmatched records:\", len(original_unmatched))\n",
    "print(\"Before DBI - unmatched net units:\", original_unmatched[\"Net Units Completed\"].sum())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "fa00b777",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Unique DBI permit coordinates: 5955\n"
     ]
    }
   ],
   "source": [
    "# Read DBI data\n",
    "with open(\"data/raw/dbi_all_study_permit_coordinates.json\", encoding=\"utf-8\") as file:\n",
    "    dbi_records = json.load(file)\n",
    "\n",
    "dbi = clean_dbi_coordinates(dbi_records)"
   ]
  },
